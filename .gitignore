# third-party sample media (YouTube videos, Wikimedia photos): fetch locally, do not redistribute
samples/
out/

# model weights: downloaded automatically (YOLO) or kept outside git (trained acoustic models)
*.pt
*.onnx
*.h5
*.keras
*.pkl
*.joblib
/models/*
# the two acoustic models are committed on purpose (0.4 MB and 62 MB)
!/models/acoustics/
!/models/acoustics/xgb_model.onnx
!/models/acoustics/cow_model.onnx

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# secrets / local config (API keys, Firebase service-account keys)
.env
*adminsdk*.json
serviceAccount*.json
service-account*.json
