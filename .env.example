# Copy this file to .env (git-ignored) and fill in your own values. Never commit real keys.

# Gemini, route 1 (Vertex AI, billed to your Google Cloud account/credits). Run once:
#   gcloud auth application-default login
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
# GCP_LOCATION=global          # Gemini 3.x models are only served from "global"; 2.5 models also work in us-central1

# Gemini, route 2 (Gemini Developer API key from AI Studio). Used when no GCP_PROJECT_ID is set.
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_BACKEND=vertex        # or api_key; auto = Vertex when a project is set

# Optional: override the model id (check it is available on your backend)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase: Project settings > Service accounts > Generate new private key, save the JSON somewhere
# OUTSIDE this repo and put its full path here.
FIREBASE_CREDENTIALS=D:\cattle-monitoring-3ce8b-firebase-adminsdk-fbsvc-34ce18d9ba.json
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIRESTORE_COLLECTION=gait_records
